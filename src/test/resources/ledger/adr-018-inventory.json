{
 "schema_version": 1,
 "record": "ADR-018",
 "ticket": "T-ADR-CRYPTO-04",
 "classes": [
  "constrained",
  "encrypted",
  "blind_indexed",
  "key_material",
  "reference",
  "absent"
 ],
 "default_class_for_unlisted_column": "encrypted",
 "tables": [
  {
   "table": "users",
   "key_scope": "user",
   "constrained": [
    "id",
    "status",
    "created_at",
    "time_zone"
   ],
   "encrypted": [
    "display_name"
   ],
   "reason": "identity row; ADR-019's account; owner_id everywhere"
  },
  {
   "table": "channels",
   "key_scope": "platform",
   "index_key": "global",
   "constrained": [
    "id",
    "account_id",
    "type",
    "verified_at",
    "matured_at",
    "suspect",
    "value_bidx_version",
    "created_at"
   ],
   "blind_indexed": [
    "value"
   ],
   "reason": "ADR-019 contact channels; CK ciphertext; single GIK equality index; partial unique (type, value_bidx) where verified"
  },
  {
   "table": "trial_fingerprints",
   "key_scope": "platform",
   "constrained": [
    "fingerprint",
    "first_trial_at",
    "trials_used"
   ],
   "rls": false,
   "reason": "K_abuse fingerprint; no subject link; retention per T-CMP-04 profile"
  },
  {
   "table": "user_keys",
   "constrained": [
    "user_id",
    "key_id",
    "purpose",
    "kek_id",
    "state",
    "encrypt_count",
    "created_at",
    "rotated_at",
    "retired_at",
    "destroyed_at"
   ],
   "key_material": [
    "wrapped_key",
    "canary"
   ],
   "reason": "wrapped DEK/IK/AK rows"
  },
  {
   "table": "accounts",
   "key_scope": "user",
   "index_key": "user",
   "constrained": [
    "id",
    "owner_id",
    "type",
    "currency",
    "is_archived",
    "created_at"
   ],
   "encrypted": [
    "name",
    "institution"
   ],
   "blind_indexed": [
    "mask"
   ],
   "reason": "financial accounts; mask resolves incoming account_ref"
  },
  {
   "table": "transactions",
   "key_scope": "user",
   "index_key": "user",
   "constrained": [
    "id",
    "owner_id",
    "occurred_at",
    "booked_at",
    "source",
    "source_confidence",
    "needs_review",
    "status",
    "category_id",
    "source_event_id",
    "dedupe_key",
    "dedupe_key_version",
    "created_at"
   ],
   "encrypted": [
    "description",
    "merchant_raw",
    "note"
   ],
   "blind_indexed": [
    "merchant_display",
    "external_ref"
   ],
   "reason": "grant predicate compares owner_id, category_id, needs_review; dedupe_key is a K_dedupe fingerprint"
  },
  {
   "table": "entries",
   "constrained": [
    "id",
    "transaction_id",
    "owner_id",
    "account_id",
    "amount_minor",
    "currency"
   ],
   "reason": "zero-sum invariant; composite FK (transaction_id, owner_id)"
  },
  {
   "table": "duplicate_links",
   "constrained": [
    "id",
    "owner_id",
    "surviving_id",
    "linked_id",
    "reason",
    "confidence",
    "decided_by",
    "created_at",
    "reversed_at",
    "reversed_by"
   ],
   "reason": "reversible fuzzy-merge link"
  },
  {
   "table": "merchants",
   "class": "reference",
   "constrained": [
    "id",
    "canonical_name",
    "normalised_key",
    "aliases",
    "default_category_hint"
   ],
   "rls": false,
   "reason": "global dictionary; no per-row link from user rows"
  },
  {
   "table": "merchant_rules",
   "key_scope": "user",
   "index_key": "user",
   "constrained": [
    "id",
    "owner_id",
    "category_id",
    "created_at"
   ],
   "encrypted": [
    "merchant_display"
   ],
   "blind_indexed": [
    "merchant_bidx"
   ],
   "reason": "learned rules keyed by blind index"
  },
  {
   "table": "sharing_grants",
   "constrained": [
    "id",
    "grantor_id",
    "grantee_id",
    "category_id",
    "detail_level",
    "granted_at",
    "expires_at",
    "revoked_at"
   ],
   "reason": "resolved by the setter into app.grant_set"
  },
  {
   "table": "access_events",
   "constrained": [
    "id",
    "viewer_id",
    "owner_id",
    "category_id",
    "detail_level",
    "policy_identifier",
    "request_id",
    "occurred_at"
   ],
   "reason": "relay-fed projection of the sharing.* audit.event the API inserts (ADR-020); id = audit_event_id; no pennilogic_app write path; erasure step by the ADR-021 job"
  },
  {
   "table": "period_aggregates",
