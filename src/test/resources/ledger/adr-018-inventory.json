  "app.recorded_admin_events_mac",
  "app.ctx_mac"
 ],
 "mac_payload": "v2|principal|request|acr|grant_set|group_set|actor|preauth_kind|preauth_value|preauth_account|admin_event|admin_subject|pg_backend_pid()|transaction_timestamp()",
 "setters": [
  "app_ctx.begin_request",
  "app_ctx.begin_keyops",
  "app_ctx.begin_preauth",
  "app_ctx.begin_admin_access",
  "app_ctx.begin_redaction"
 ],
 "definer_owners": [
  "pennilogic_ctx",
  "ADR-020 administrative function owner",
  "ADR-020 audit-trail function owner",
  "ADR-020 transparency-relay function owner"
 ],
 "roles": [
  {
   "role": "pennilogic_app",
   "login": true,
   "bypassrls": false,
   "superuser": false,
   "settings": {
    "statement_timeout": "15s",
    "transaction_timeout": "20s",
    "idle_in_transaction_session_timeout": "5s",
    "lock_timeout": "5s",
    "log_error_verbosity": "terse",
    "log_statement": "none",
    "log_parameter_max_length": 0,
    "log_parameter_max_length_on_error": 0
   }
  },
  {
   "role": "pennilogic_keyops",
   "login": true,
   "bypassrls": false,
   "superuser": false,
   "settings": {
    "log_error_verbosity": "terse"
   },
   "erasure_grants": {
    "delete": [
     "channels",
     "push tokens",
     "duplicate_links",
     "period_aggregates",
     "access_events (subject's own rows; transparency_erasure, ADR-020)"
    ],
    "update": [
     "user_keys.state/destroyed_at/wrapped_key",
     "sharing_grants.revoked_at (erasure_grant_rows)",
     "split_group_members.left_at (erasure_membership_rows)",
     "access_events.viewer_id pseudonym (transparency_erasure, ADR-020)"
    ],
    "context": "begin_keyops(subject, erasure job)",
    "never": [
     "entries"
    ]
   }
  },
  {
   "role": "pennilogic_ctx",
   "login": false,
   "bypassrls": false,
   "superuser": false
  }
 ],
 "key_classes": [
  {
   "id": "KEK",
   "scope": "platform",
   "cryptoperiod_days": 365,
   "custody": "custodian, non-exportable"
  },
  {
   "id": "DEK",
   "scope": "user",
   "cryptoperiod_days": 730,
   "encrypt_cap": 268435456,
   "rotation_due_at": 134217728,
   "fail_closed_at": 251658240
  },
  {
   "id": "IK",
   "scope": "user",
   "cryptoperiod_days": 730,
   "rotates_with": "DEK"
  },
  {
   "id": "AK",
   "scope": "user",
   "cryptoperiod": "no scheduled rotation",
   "destroyed_on_erasure": true,
   "purpose": "analytics pseudonym HMAC(AK,'analytics')"
  },
  {
   "id": "GIK",
   "scope": "platform",
   "cryptoperiod_days": 365,
   "rotation": "single transaction over channels"
  },
  {
   "id": "CK",
   "scope": "platform",
   "cryptoperiod_days": 365,
   "rotation": "single transaction over channels"
  },
  {
   "id": "K_abuse",
   "scope": "platform",
   "cryptoperiod": "T-CMP-04 abuse window"
  },
  {
   "id": "K_dedupe",
   "scope": "platform",
   "cryptoperiod_days": 730,
   "version_column": "transactions.dedupe_key_version"
  },
  {
   "id": "K_ctx",
   "scope": "database",
   "cryptoperiod_days": 90,
   "rotated_on_restore": true
  },
  {
   "id": "K_install",
   "scope": "device",
   "cryptoperiod": "install lifetime",
   "custody": "Android Keystore"
  }
 ],
 "retirement_rule": "zero live references AND re-encryption completion + backup retention elapsed AND canary decrypt AND journal proof",
 "erasure_completeness_bound": "T-PLT-02 backup retention",
 "dedupe_artefacts": [
  {
   "name": "raw_event_digest",
   "location": "device only",
   "key": "K_install",
   "inputs": [
    "sender_id",
    "normalised_body",
    "channel"
   ]
  },
  {
   "name": "transactions.dedupe_key",
   "location": "server column",
   "key": "K_dedupe[v]",
   "inputs": [
    "owner_id",
    "account_id|account:unresolved",
    "amount_minor",
    "currency",
    "direction",
    "occurred_at@minute UTC"
   ],
   "output_only": true
  },
  {
   "name": "fuzzy_candidate_match",
   "location": "server pipeline / duplicate_links",
   "key": null,
   "outcome": "reversible link + audit; never delete"
  }
 ],
 "request_replay_artefact": "ADR-015 Idempotency-Key (not a deduplication artefact)",
 "triggers": [
  "app_ctx.record_admin_event() BEFORE INSERT ON audit.event (no EXECUTE granted)"
 ],
 "key_scope_values": [
  "user",
  "group",
  "platform",
  "none"
 ],
 "access_events_model": "relay-fed projection of the sharing.* audit.event (ADR-020); id = audit_event_id (UUIDv7); subject reads under owner_rows; transparency_append withdrawn",
 "adr020_interface": {
  "sharing_audit_event_insert_with_check": "actor_principal_id = app_ctx.verified_customer_principal() AND CASE WHEN action LIKE '<cross-user-read prefix>%' THEN subject_id in grant-set owners AND policy_identifier IN (grant_mediated_read, grant_mediated_aggregate_read) ELSE subject_id = actor_principal_id END",
  "record_admin_event_trigger": "attached BEFORE INSERT ON audit.event by ADR-020's trail migration; no insert path bypasses it",
  "event_committed": "audit.event_committed(id) is true only when the inserting top-level transaction has completed and committed; the current transaction and its subtransactions never satisfy it; ADR-020 defines the stage-and-fetch pair",
  "context_transaction_returns_no_rows": "a transaction holding an administrative context writes masked results to admin_api.staged_result (unreadable by admin_app) and returns only the event id; disclosure only from the frozen stage in a later transaction after audit.event_committed and single consumption",
  "transparency_erasure": "FOR UPDATE, DELETE TO pennilogic_keyops on access_events, admitting exactly the erasure projection step under begin_keyops(subject, erasure job)",
  "materialisation_committed": "collect requires audit.event_committed(event) AND materialisation_committed: the tuple that set materialised_at was written by a completed, committed top-level transaction that is not the current transaction or one of its subtransactions; consume once; frozen rows only",
  "tests": [
   "admin_context_denied_for_uncommitted_event",
   "admin_read_and_stage_admitted_only_for_committed_event",
   "admin_context_transaction_returns_no_rows",
   "same_transaction_materialise_then_collect_yields_nothing"
  ]
 }
}
