 "absent_everywhere": [
  "raw message text",
  "raw_hash",
  "message_digest",
  "any raw-derived digest",
  "any *_bidx value in an API, sync or export schema"
 ],
 "encrypted_money_encoding": "ADR-015 Money wire object as UTF-8 JSON; row currency column must agree",
